--- a/src/ffi.rs
+++ b/src/ffi.rs
@@ -1028,6 +1028,22 @@
         Ok(v) => v as ssize_t,
 
         Err(e) => e.to_c(),
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn quiche_conn_stream_capacity_with_error(
+    conn: &mut Connection, stream_id: u64, out_error_code: &mut u64,
+) -> ssize_t {
+    match conn.stream_capacity(stream_id) {
+        Ok(v) => v as ssize_t,
+
+        Err(e) => {
+            if let Error::StreamStopped(error) = e {
+                *out_error_code = error;
+            }
+            e.to_c()
+        },
     }
 }
 
