+// Returns the stream's send capacity in bytes.
+// out_error_code is only set when STREAM_STOPPED is returned, to the application
+// error code received in STOP_SENDING. This call may reclaim a completed stream.
+ssize_t quiche_conn_stream_capacity_with_error(quiche_conn *conn,
+                                               uint64_t stream_id,
+                                               uint64_t *out_error_code);
+
 // Returns true if the stream has data that can be read.
